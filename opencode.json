{
  "$schema": "https://opencode.ai/config.json",
  "model": "volcengine-plan/minimax-m3",
  "small_model": "volcengine-plan/deepseek-v4-flash",
  "plugin": [
    "opencode-notificator"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "provider": {
    "volcengine-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Volcano Engine Coding Plan",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/coding/v3",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "ark-code-latest": {
          "name": "Auto",
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "doubao-seed-2.0-code": {
          "name": "Doubao-Seed-2.0-Code",
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "doubao-seed-2.0-pro": {
          "name": "Doubao-Seed-2.0-pro",
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "doubao-seed-2.0-lite": {
          "name": "Doubao-Seed-2.0-lite",
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "doubao-seed-code": {
          "name": "Doubao-Seed-Code",
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 32768
          }
        },
        "minimax-m3": {
          "name": "MiniMax-M3",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek-V4-Flash",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek-V4-Pro",
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          }
        },
        "glm-5.1": {
          "name": "GLM-5.1",
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 32768
          }
        },
        "minimax-latest": {
          "name": "MiniMax-M2.7",
          "reasoning": true,
          "limit": {
            "context": 204800,
            "output": 32768
          }
        },
        "kimi-k2.6": {
          "name": "Kimi-K2.6",
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "volcengine-plan/minimax-m3",
      "prompt": "你所有的自然语言输出（思考过程、计划、诊断、说明、回复）必须使用简体中文。代码、变量名、类名、文件名等保持英文。"
    },
    "plan": {
      "mode": "primary",
      "model": "volcengine-plan/doubao-seed-2.0-pro",
      "prompt": "你所有的自然语言输出（思考过程、计划、诊断、说明、回复）必须使用简体中文。代码、变量名、类名、文件名等保持英文。",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "chat": {
      "mode": "primary",
      "description": "专业编程知识问答，不修改代码",
      "model": "volcengine-plan/doubao-seed-2.0-pro",
      "temperature": 0.3,
      "prompt": "你所有的自然语言输出（思考过程、计划、诊断、说明、回复）必须使用简体中文。代码、变量名、类名、文件名等保持英文。",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "volcengine-plan/deepseek-v4-flash",
      "prompt": "你所有的自然语言输出（思考过程、计划、诊断、说明、回复）必须使用简体中文。代码、变量名、类名、文件名等保持英文。"
    },
    "general": {
      "mode": "subagent",
      "model": "volcengine-plan/deepseek-v4-pro",
      "prompt": "你所有的自然语言输出（思考过程、计划、诊断、说明、回复）必须使用简体中文。代码、变量名、类名、文件名等保持英文。"
    }
  }
}
